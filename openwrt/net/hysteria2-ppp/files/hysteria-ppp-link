#!/bin/sh
# Supervisor for one member link of a Multilink PPP bundle.
#
#   hysteria2-ppp-link <interface> <supervisor-index> <slot-count>
#
# Started detached by the protocol handler, one per configured server, and
# stopped again from its teardown. Its own index names nothing but its pid file:
# which server it dials is decided per attempt by the claim pool, so with N
# servers and N supervisors exactly one sits idle while the pppd netifd runs
# holds a slot -- and that idle one is what takes over when that slot is freed.
#
# Everything else it needs is in /var/run/hysteria-<interface>.link, written by
# the handler with mode 600: the PPP password is in there, and anything a member
# pppd is given on its command line is readable from ps. The holder's own
# credential is on its argv via ppp.sh regardless -- see hysteria.sh.
#
# Why this is not netifd's job: netifd runs exactly one process per interface,
# and a second proto_run_command would kill the first rather than join it. Why it
# is not procd's job: the lifetime being modelled is the interface's, not the
# system's -- these links must exist while the bundle exists and not one moment
# longer, and coupling them to ifup/ifdown is what gets that right.

CONFIG="$1"
IDX="$2"
COUNT="$3"

# Defined before anything that can fail, and tolerant of an HY_IFNAME that does
# not exist yet, because every check below used to exit in silence. The handler
# starts this script with both stdout and stderr on /dev/null and records $!
# unconditionally, so a supervisor that died here left behind a pid file naming a
# process that was already gone and not one line anywhere. "Never started",
# "waiting for a bundle that will never form" and "running normally" were the
# same empty log, which is exactly the question an operator cannot answer after
# an outage has recovered.
log() {
	logger -t hysteria -p "daemon.$1" "${HY_IFNAME:-$CONFIG} sup ${IDX:-?}: $2"
}

if [ -z "$CONFIG" ] || [ -z "$IDX" ] || [ -z "$COUNT" ]; then
	logger -t hysteria -p daemon.err \
		"hysteria2-ppp-link: usage: <interface> <supervisor-index> <slot-count>"
	exit 1
fi

COMMON=/usr/libexec/hysteria2-ppp-common
if [ ! -r "$COMMON" ]; then
	log err "cannot read $COMMON, supervisor cannot start"
	exit 1
fi
# shellcheck disable=SC1090  # installed alongside this script by the package
. "$COMMON"

ENVFILE="/var/run/hysteria-$CONFIG.link"
# Keyed on the pid as well as the index: hysteria_links_stop signals and
# returns without waiting, so a dying supervisor can still be holding this name
# when the next generation's supervisor of the same index has already written it.
OPTSFILE="/var/run/hysteria-$CONFIG-sup$IDX-$$.pppd"
ERRFILE="/var/run/hysteria-$CONFIG-sup$IDX-$$.err"

if [ ! -r "$ENVFILE" ]; then
	log err "cannot read $ENVFILE, supervisor cannot start"
	exit 1
fi
# "." is a POSIX special builtin, so a parse error in the generated file exits
# this shell on the spot -- before any of the code that would explain it. The
# handler's hysteria_env_line quotes every value precisely to stop that, so this
# should never fire; it is here because its failure mode is the one that cannot
# be diagnosed from outside, and one fork per supervisor start is a cheap price
# for never having to guess again.
if ! sh -n "$ENVFILE" 2>/dev/null; then
	log err "$ENVFILE is not valid shell, supervisor cannot start"
	exit 1
fi
# shellcheck disable=SC1090  # generated by the protocol handler, not a source file
. "$ENVFILE"

PPPD_PID=""
SLOT=""
# Which pid the claim currently names. The supervisor holds it until pppd is up,
# then hands it over, so that a supervisor killed outright leaves a claim naming
# the process that really still holds the server -- see hysteria_claim_retarget.
HY_CLAIM_PID=""
# The state last announced, so the log carries edges instead of a heartbeat --
# see announce() below. Initialised to the state the startup line declares.
state=waiting

# pppd's options-file parser understands double quotes with backslash escapes, so
# a password containing a space or a quote survives the round trip. Values that
# reach pppd through this file never appear in the process table.
ppp_quote() {
	printf '"%s"' "$(printf '%s' "$1" | sed -e 's/[\\"]/\\&/g')"
}

write_options() {
	local slot="$1"

	rm -f "$OPTSFILE"
	touch "$OPTSFILE" || return 1
	chmod 600 "$OPTSFILE" || return 1

	{
		# The operator's own options first, so everything below overrides them.
		# A member that honoured a stray "defaultroute" or dropped "noip" would
		# stop being a member; the settings after this point are what make it one.
		[ -n "$HY_PPPD_OPTIONS" ] && echo "$HY_PPPD_OPTIONS"

		echo "nodetach"
		echo "noauth"

		# The bundle's own settings. "bundle" is what keeps this interface's links
		# from being merged with another hysteria interface's: pppd keys a bundle
		# on the peer's authenticated name and the peer's endpoint discriminator,
		# and an LNS supplies neither reliably, so without a local bundle name the
		# key can collapse to something two unrelated interfaces share.
		# "endpoint" is the opposite half -- it is what the LNS bundles on, so it
		# must match every other link of ours exactly.
		echo "multilink"
		echo "bundle $(ppp_quote "$HY_BUNDLE")"
		echo "endpoint $(ppp_quote "$HY_EPDISC")"

		# The link ceiling, not the bundle MTU. Each fragment is bounded by what
		# one link carries; the bundle is six octets less, and pppd derives that
		# itself from MIN(peer MRRU, our MRU).
		echo "mru $HY_LINK_MRU"
		echo "mrru $HY_LINK_MRU"
		echo "mtu $HY_BUNDLE_MTU"

		# Each MP link runs its own LCP, so these echoes are per link. They are
		# the only thing that notices one server going quiet while the others keep
		# carrying traffic -- the bundle stays up, so nothing else would.
		if [ -n "$HY_LCP_FAILURE" ] && [ "$HY_LCP_FAILURE" -gt 0 ] 2>/dev/null; then
			echo "lcp-echo-interval ${HY_LCP_INTERVAL:-5}"
			echo "lcp-echo-failure $HY_LCP_FAILURE"
			# No "lcp-echo-adaptive" here, unlike the holder. The adaptive test
			# suppresses an echo only when the interface counters moved since the
			# last one, and it reads them by the global ifname -- which on a member
			# is the unit name pppd made up, not the device. The fetch fails every
			# time, so the suppression never happens and the only effect is a
			# "Couldn't get PPP statistics" line per echo per member, forever.
		fi

		# A member contributes bandwidth to a bundle and nothing else: no address,
		# no route, and it must never present itself to netifd as an interface.
		#
		# Both of these are also the second line of defence behind the gate, and
		# they only work as a pair. A link that reached negotiation without
		# joining a bundle falls through to continue_networks(), where pppd does
		#
		#	if (num_np_open == 0)
		#		lcp_close(0, "No network protocols running");
		#
		# so with every NCP disabled it closes itself instead of standing up a
		# rival PPP session against the same subscriber. Leave IPv6CP enabled and
		# that guard does not fire, because one network protocol is still open.
		echo "noip"
		echo "noipv6"
		echo "noccp"
		echo "nodefaultroute"

		# Exit after one failed attempt and let the loop below redial. Never
		# "persist": pppd checks its multilink options once, outside the
		# connection loop, and clears doing_multilink only when the whole bundle
		# terminates. A member that redials *internally* therefore re-enters
		# mp_join_bundle() with doing_multilink still set, takes its early return,
		# and never issues PPPIOCCONNECT -- leaving a channel attached to nothing
		# and a link that looks up while carrying no traffic at all.
		echo "maxfail 1"

		# The bundle's device name, and the single most load-bearing option here.
		#
		# A member that joins never creates a unit, so this changes nothing on the
		# path that works. It decides what happens on the path that does not: a
		# member that reaches make_new_bundle() calls make_ppp_unit_rtnetlink(),
		# which passes this name with NLM_F_EXCL, so the kernel refuses the
		# duplicate, pppd dies with "Couldn't create ppp interface", and the
		# supervisor retries.
		#
		# Without it the member creates its own unit instead -- ppp1 -- and, worse,
		# writes its own UNIT= record into pppd's shared database. That record is
		# what owns_unit() consults when the NEXT member looks the bundle up, so
		# one failed join makes every subsequent join fail too, permanently, even
		# though the bundle keys match exactly. That is not a diagnostic nicety;
		# it is the difference between a bundle that forms and one that never can.
		echo "ifname $(ppp_quote "$HY_IFNAME")"

		# Its own pid file, so members do not overwrite each other's or the
		# holder's.
		echo "linkname $(ppp_quote "hy-$CONFIG-$slot")"

		echo "user $(ppp_quote "$HY_USER")"
		echo "password $(ppp_quote "$HY_PASS")"

		# The client's stderr is redirected here, inside the pty command, and not
		# on pppd's own command line where it looks like it belongs. pppd chooses
		# fd 2 for its pty child itself -- device_script() sets it to log_to_fd,
		# which defaults to 1, pppd's stdout -- and the pppd below is started with
		# stdout on /dev/null. So everything the client had to say about a refused
		# QUIC handshake or a bad config went to /dev/null, and the "2>>" on the
		# pppd invocation caught only pppd's own stderr.
		#
		# Only fd 2 is touched. Stdin and stdout are the pty and carry PPP frames.
		echo "pty $(ppp_quote "HYSTERIA_PPP_STATUS=$(hysteria_slot_status "$CONFIG" "$slot") /usr/bin/hysteria2-ppp client -c $(hysteria_slot_yaml "$CONFIG" "$slot") 2>>$ERRFILE")"
	} >> "$OPTSFILE"
}

stop_pppd() {
	[ -n "$PPPD_PID" ] || return 0
	kill -TERM "$PPPD_PID" 2>/dev/null
	# pppd needs a moment to hang up: it has an LCP Terminate to send and a
	# bundle-links record to drop. Killing it outright leaves the LNS holding a
	# session it will only reap on its own timeout, which delays the rejoin.
	local i=0
	while [ "$i" -lt 10 ] && kill -0 "$PPPD_PID" 2>/dev/null; do
		sleep 1
		i=$((i + 1))
	done
	kill -KILL "$PPPD_PID" 2>/dev/null
	wait "$PPPD_PID" 2>/dev/null
	PPPD_PID=""
	# pppd is gone, so the claim is this shell's again and release can free it.
	HY_CLAIM_PID=""
}

cleanup() {
	trap '' TERM INT
	# Teardown was the third silent state, and the one that made the other two
	# unreadable. A dead transport shows up as netifd rebuilding the interface
	# every 36 seconds -- pppd's 30 second LCP timeout plus the hangup -- and each
	# rebuild starts a fresh generation of supervisors. Without this line the log
	# is a stack of identical "supervisor started" lines with no way to see that
	# every one of them was torn down seconds later having never dialled.
	log notice "supervisor stopping (was: $state)"
	stop_pppd
	hysteria_release_slot "$CONFIG" "$SLOT"
	rm -f "$OPTSFILE" "$ERRFILE"
	exit 0
}
trap cleanup TERM INT

# The gate is two facts, not one.
#
# The flag file says a bundle was created, which is what a member has to know
# before it dials: if the LNS refused MRRU the holder came up as an ordinary
# single PPP link, and a second link would not be joining anything.
#
# The network device says the bundle is still there right now. If the holder's
# pppd is killed outright it never runs ip-down, so the flag file outlives the
# bundle -- and nothing else would tell a member. The SIGHUP fan-out that a
# clean teardown does is a userland walk over pppd's own database, so it does not
# happen either, and the kernel gives a channel no EOF when the unit goes: the
# dead flag it would test belongs to the interface's file, not to a channel's.
# Members would run forever attached to a unit that no longer exists. The /sys
# check is the only thing that sees it, and it sees it at once, because
# unregister_netdevice unlinks the device synchronously.
gate_open() {
	[ -f "$HY_GATE" ] && [ -d "/sys/class/net/$HY_IFNAME" ]
}

# Backoff mirrors the Hysteria client's own: a server that is simply down should
# not be dialled once a second forever, but a link that ran for a while before
# dropping should come back promptly.
backoff=0
readonly BACKOFF_MAX=30
readonly RUN_CONSIDERED_GOOD=30
# How many lines of a failed link's accumulated stderr are replayed into syslog,
# and how much of it may pile up on tmpfs while the link is running.
readonly ERR_REPLAY_MAX=10
readonly ERR_MAX_BYTES=65536

# announce logs a state the supervisor has just entered, and only if it was not
# already in it.
#
# Both of the waiting states below persist for exactly as long as their condition
# does, which for an LNS that never accepts MRRU is forever. Logging them per
# iteration would put a line in the ring every two seconds and evict everything
# that matters; logging them not at all is what made an idle supervisor and a dead
# one indistinguishable. The edge is the only part worth saying, and it is said
# once.
announce() {
	[ "$state" = "$1" ] && return 0
	state="$1"
	log notice "$2"
}

log notice "supervisor started, waiting for the bundle"

while :; do
	# Teardown removes this file. Checking for it means a supervisor that somehow
	# outlived the signal still stops on its own rather than dialling into an
	# interface that no longer exists.
	[ -r "$ENVFILE" ] || cleanup

	if ! gate_open; then
		announce waiting "waiting for the bundle"
		backoff=0
		sleep 2
		continue
	fi

	# Claimed per attempt, not once at startup. With N supervisors and N servers
	# one supervisor finds nothing free -- that is the one covering the slot the
	# holder is using, and it starts dialling the moment the holder gives it up.
	if ! SLOT=$(hysteria_claim_slot "$CONFIG" "$COUNT"); then
		SLOT=""
		# Said once, because it is permanent and because its absence is actively
		# misleading: an operator counting "dialling" lines against configured
		# servers always comes up one short, and nothing else explains why.
		announce spare "every server is already dialled, standing by as the spare"
		sleep 5
		continue
	fi

	if ! write_options "$SLOT"; then
		log err "cannot write pppd options, retrying"
		hysteria_release_slot "$CONFIG" "$SLOT"
		SLOT=""
		sleep 5
		continue
	fi

	rm -f "$(hysteria_slot_status "$CONFIG" "$SLOT")" "$ERRFILE"
	started=$(cut -d' ' -f1 /proc/uptime | cut -d. -f1)

	# pppd's own stderr, to the same file the client's is redirected to in
	# write_options(). Both open it O_APPEND, so the two interleave a line at a
	# time and the replay below covers whichever of them had something to say.
	#
	# This is deliberately not the client's stderr, whatever it may once have
	# looked like: pppd does not pass its own fd 2 down to the pty child.
	/usr/sbin/pppd file "$OPTSFILE" >/dev/null 2>>"$ERRFILE" &
	PPPD_PID=$!
	# From here the server is held by pppd, not by this shell.
	hysteria_claim_retarget "$CONFIG" "$SLOT" "$PPPD_PID"
	# Naming the pid is what makes the rest of syslog readable: pppd tags every
	# line with "pppd[<pid>]" and nothing else says which server that pid dialled,
	# so without this line a bundle's worth of interleaved links is unattributable.
	log notice "dialling $(hysteria_server_of "$CONFIG" "$SLOT") (slot $SLOT) as pppd[$PPPD_PID]"
	state=dialling

	# Watch two things at once: pppd, and the bundle it is attached to. The second
	# is what breaks the case where the holder was killed without ip-down running
	# -- the member's own transport is fine, the LNS still answers its echoes, and
	# nothing else would ever tell it the bundle is gone.
	tick=0
	while kill -0 "$PPPD_PID" 2>/dev/null; do
		if ! gate_open; then
			log notice "bundle gone, taking link down"
			stop_pppd
			break
		fi
		# /var/run is tmpfs, and nothing empties this file until the link ends, so
		# a client that writes to stderr in a loop would hold the whole of it in
		# RAM for as long as the link lives. Sampled once a minute rather than
		# every pass: wc is a fork, and the loop runs every two seconds per member.
		tick=$((tick + 1))
		if [ $((tick % 30)) -eq 0 ] && [ -s "$ERRFILE" ] &&
			[ "$(wc -c < "$ERRFILE" 2>/dev/null || echo 0)" -gt "$ERR_MAX_BYTES" ]; then
			true 2>/dev/null > "$ERRFILE"
			log warn "link stderr passed $ERR_MAX_BYTES bytes, discarded"
		fi
		sleep 2
	done

	if [ -n "$PPPD_PID" ]; then
		wait "$PPPD_PID" 2>/dev/null
		PPPD_PID=""
		HY_CLAIM_PID=""
	fi

	# The client records a terminal reason here -- a refused credential, an
	# identity the server has no route for. netifd has one error channel per
	# interface and the holder owns it, so for a member this is the only place it
	# can be said.
	# Whatever pppd or the client wrote on the way out.
	if [ -s "$ERRFILE" ]; then
		# Capped -- and now actually capped. This loop was unbounded despite
		# saying otherwise: ERRFILE is opened with ">>" and emptied only here, so
		# a link that ran for hours replayed every line it had ever written, one
		# logger fork each, at the moment it dropped. A 64 KiB log ring holds a
		# few hundred lines, so that flood evicted the "dialling" lines naming the
		# server that had just failed -- the one thing the replay exists to give
		# context to.
		errlines=0
		while read -r line; do
			[ -n "$line" ] || continue
			errlines=$((errlines + 1))
			[ "$errlines" -le "$ERR_REPLAY_MAX" ] && log warn "$line"
		done < "$ERRFILE"
		[ "$errlines" -gt "$ERR_REPLAY_MAX" ] &&
			log warn "$((errlines - ERR_REPLAY_MAX)) further stderr lines suppressed"
		true 2>/dev/null > "$ERRFILE"
	fi

	statusfile=$(hysteria_slot_status "$CONFIG" "$SLOT")
	if [ -s "$statusfile" ]; then
		read -r reason < "$statusfile"
		log warn "link ended: $reason"
		rm -f "$statusfile"
	fi

	hysteria_release_slot "$CONFIG" "$SLOT"
	SLOT=""

	now=$(cut -d' ' -f1 /proc/uptime | cut -d. -f1)
	if [ $((now - started)) -ge "$RUN_CONSIDERED_GOOD" ]; then
		backoff=0
	else
		backoff=$((backoff == 0 ? 1 : backoff * 2))
		[ "$backoff" -gt "$BACKOFF_MAX" ] && backoff=$BACKOFF_MAX
	fi
	sleep "$((backoff > 0 ? backoff : 1))"
done
