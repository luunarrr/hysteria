#!/bin/sh
# Which servers each Hysteria interface is connected to, as a table.
#
#   hysteria-ppp-status [interface ...]
#
# Same collector as the ubus object, so the two cannot come to different
# conclusions about the same router -- which is the whole reason the collector is
# a library and not a function inside either of them.
#
# Exit status is the worst state found, so this drops into a cron check without
# anything having to parse it:
#
#   0  every configured server is carrying
#   1  the interface is up but at least one server is not
#   2  no interface is up, or none exists

# Conditional for the same reason the library's own source line is: it lets the
# suite point both formatters at a scratch directory without either of them
# taking a path out of the environment.
# shellcheck disable=SC1091  # installed alongside this file by the package
command -v hysteria_status_json >/dev/null 2>&1 ||
	. /usr/libexec/hysteria2-ppp-statuslib

# Field of a flat JSON object, without a JSON parser. The collector emits every
# value on one line and escapes what it emits, so this is reading back a format
# this package controls end to end rather than parsing JSON in sed -- which is
# why it is acceptable here and would not be anywhere else.
field() {
	printf '%s' "$1" | sed -n "s/.*\"$2\":\"\\([^\"]*\\)\".*/\\1/p"
}

number() {
	printf '%s' "$1" | sed -n "s/.*\"$2\":\\([0-9-]*\\).*/\\1/p"
}

# Seconds as the coarse duration a human reads at a glance. Deliberately not
# padded to a fixed width: a bundle that has been up for six days should not have
# its uptime abbreviated to make room for the minutes.
duration() {
	local s="$1"
	[ -n "$s" ] && [ "$s" -ge 0 ] 2>/dev/null || {
		printf -- '-'
		return
	}
	if [ "$s" -ge 86400 ]; then
		printf '%dd %02dh' $((s / 86400)) $(((s % 86400) / 3600))
	elif [ "$s" -ge 3600 ]; then
		printf '%dh %02dm' $((s / 3600)) $(((s % 3600) / 60))
	elif [ "$s" -ge 60 ]; then
		printf '%dm %02ds' $((s / 60)) $((s % 60))
	else
		printf '%ds' "$s"
	fi
}

# Bytes as the figure a human reads.
#
# Decimal units and two decimal places, which is what LuCI's "%.2mB" produces and
# therefore what Network -> Interfaces prints for the same interface. The status
# page in luci-proto-hysteria implements the identical shape, so this command and
# that page cannot report the same router differently -- which is the same reason
# the collector behind both of them is one library.
#
# The fraction comes out of the last division's remainder because a POSIX shell
# has no floating point: dividing first and formatting afterwards would print
# every value as a whole number, and "1 GB" for anything between 1.0 and 2.0 is
# the wrong answer often enough to matter on a page about throughput.
#
# "greater than" rather than "at least", matching LuCI, which is why exactly 1000
# prints as "1000 B" rather than "1.00 KB".
#
# Identical to LuCI's output across the range bar one case: at an exact half-way
# boundary this rounds up where toFixed may not, so 1005000000 reads 1.01 GB here
# and 1.00 GB there. Not worth chasing -- it needs floating point, which a POSIX
# shell has none of, and the figure this prints is never the same quantity as one
# LuCI renders.
human() {
	local b="$1" i=0 div=1 whole frac
	[ -n "$b" ] && [ "$b" -ge 0 ] 2>/dev/null || {
		printf -- '-'
		return
	}
	# The unit is chosen by comparing the ORIGINAL value against 1000^(i+1),
	# rather than by dividing and re-testing the quotient. Those are not the same
	# test, and the difference is a whole unit: LuCI divides in floating point and
	# keeps the fraction, so 1000500 steps twice and reads "1.00 MB", while
	# dividing with truncation leaves exactly 1000 -- which fails a "greater than
	# 1000" test and stops a unit short at "1000.50 KB". Every value in the
	# thousand just above a unit boundary lands in that gap.
	#
	# The intermediates stay well inside int64: div reaches 10^12, div*1000 is
	# 10^15, and (b % div) * 100 is under 10^14. OpenWrt builds BusyBox with
	# FEATURE_SH_MATH_64 by default, so that holds on a 32-bit target too.
	while [ "$i" -lt 4 ] && [ "$b" -gt $((div * 1000)) ]; do
		div=$((div * 1000))
		i=$((i + 1))
	done
	if [ "$i" = 0 ]; then
		printf '%s B' "$b"
		return
	fi
	whole=$((b / div))
	# Rounded rather than truncated, because LuCI's toFixed rounds. The carry is
	# not theoretical: a remainder a hair under the divisor rounds to 100
	# hundredths, and without it 1999 would print as "1.100 KB".
	frac=$(((((b % div) * 100) + (div / 2)) / div))
	if [ "$frac" -ge 100 ]; then
		frac=$((frac - 100))
		whole=$((whole + 1))
	fi
	printf '%s.%02d %s' "$whole" "$frac" \
		"$(case $i in 1) echo KB ;; 2) echo MB ;; 3) echo GB ;; *) echo TB ;; esac)"
}

state_text() {
	case "$1" in
	carrying) echo "in bundle" ;;
	connected) echo "connected" ;;
	dialling) echo "connecting" ;;
	refused) echo "refused by bundle" ;;
	retrying) echo "retrying" ;;
	blocked) echo "stopped" ;;
	*) echo "idle" ;;
	esac
}

bundle_text() {
	case "$1" in
	formed) echo "bundle formed" ;;
	refused) echo "single link, peer refused multilink" ;;
	off) echo "single link" ;;
	*) echo "down" ;;
	esac
}

rc=2

names="$*"
[ -n "$names" ] || names=$(hysteria_status_interfaces)
[ -n "$names" ] || {
	echo "no hysteria interface is configured" >&2
	exit 2
}

for name in $names; do
	doc=$(hysteria_status_json "$name") || {
		echo "$name: not set up" >&2
		continue
	}

	# The document down to the links array, and every interface-level field is
	# read from this rather than from the whole of it.
	#
	# Not tidiness. field and number are greedy seds, so they return the *last*
	# match in whatever they are given, and a link now carries rx_bytes and
	# tx_bytes under the same names as the interface does. Reading those off the
	# whole document would silently report the last link's throughput as the
	# bundle's -- a wrong number that looks entirely plausible.
	head=${doc%%'"links":'*}

	device=$(field "$head" device)
	bundle_state=$(field "$head" bundle_state)
	configured=$(number "$head" links_configured)
	up=$(number "$head" links_up)
	mtu=$(number "$head" mtu)
	ignored=$(number "$head" servers_ignored)
	spare=$(number "$head" supervisors_spare)
	dev_rx=$(number "$head" rx_bytes)
	dev_tx=$(number "$head" tx_bytes)

	printf '%-6s %-9s %-38s %s/%s links   mtu %s\n' \
		"$name" "$device" "$(bundle_text "$bundle_state")" \
		"$up" "$configured" "$mtu"

	# The bundle device's own counters, which is the figure Network -> Interfaces
	# shows for this interface. Printed before the table because it is the total
	# the rows below add up to -- near enough. They do not sum exactly and cannot:
	# the rows are PPP frames counted by the clients, this is the kernel counting
	# IP packets after reassembly, and the difference is the per-fragment
	# multilink header plus every LCP echo the links exchange.
	if [ -n "$dev_rx" ] || [ -n "$dev_tx" ]; then
		printf '  %-46s RX %-14s TX %s\n' '' "$(human "$dev_rx")" "$(human "$dev_tx")"
	fi

	case "$doc" in
	*'"up":true'*)
		if [ "$up" = "$configured" ]; then
			[ "$rc" -le 0 ] || rc=0
		else
			rc=1
		fi
		;;
	esac

	printf '  %-2s %-30s %-7s %-18s %-10s %-11s %-11s %s\n' \
		'#' 'server' 'role' 'state' 'for' 'rx' 'tx' 'last event'

	# One line per link. Splitting the array on "},{" rather than parsing it: the
	# collector writes both, and nothing in a value can contain that sequence,
	# every value being escaped before it goes in.
	links=${doc#*'"links":['}
	links=${links%']}'}
	OLDIFS=$IFS
	IFS='
'
	for link in $(printf '%s' "$links" | sed -e 's/},{/}\n{/g'); do
		[ -n "$link" ] || continue
		slot=$(number "$link" slot)
		server=$(field "$link" server)
		role=$(field "$link" role)
		state=$(field "$link" state)
		since=$(number "$link" for)
		errcode=$(field "$link" code)
		errago=$(number "$link" ago)
		rx=$(number "$link" rx_bytes)
		tx=$(number "$link" tx_bytes)

		note='-'
		[ -n "$errcode" ] && note="$errcode, $(duration "$errago") ago"

		printf '  %-2s %-30s %-7s %-18s %-10s %-11s %-11s %s\n' \
			"$slot" "${server:--}" "${role:--}" \
			"$(state_text "$state")" "$(duration "$since")" \
			"$(human "$rx")" "$(human "$tx")" "$note"
	done
	IFS=$OLDIFS

	[ "${spare:-0}" -gt 0 ] 2>/dev/null &&
		printf '  %s supervisor(s) spare, by design\n' "$spare"
	[ "${ignored:-0}" -gt 0 ] 2>/dev/null &&
		printf '  %s additional server(s) configured but multilink is disabled\n' "$ignored"
	echo
done

exit "$rc"
